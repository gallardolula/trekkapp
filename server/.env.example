# Copy to .env and adjust. The .env file is not versioned.
DATABASE_URL=postgres://localhost:5432/trekkapp
PORT=4000
HOST=0.0.0.0

# Token signing key. In production it comes from the provider's secret
# manager and never from the repository.
JWT_SECRET=desarrollo-local-cambiar-en-produccion-con-una-clave-larga
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Directory holding the generated .mbtiles archives. Defaults to ../tiles/out.
TILES_DIR=

# Where the verification codes are sent from. Left empty, the server starts
# anyway and writes every code to its own log, which is what makes local
# work and the test suite possible without a mail account. It says so loudly
# at startup, because a server that silently stopped delivering codes looks
# exactly like one that works.
#
# With Gmail, SMTP_PASS is an application password generated for this server
# in the Google account's security settings, never the account's own
# password, which Google no longer accepts over SMTP. Generating one
# requires two step verification to be on for that account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER. Gmail requires the sender to be the account itself.
MAIL_FROM=
