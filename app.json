{
  "expo": {
    "name": "trekkapp",
    "slug": "trekkapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TrekkApp usa tu ubicación para mostrar tu posición sobre el sendero y avisarte si te apartás de la traza."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "ar.edu.siglo21.trekkapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "cameraPermission": "TrekkApp usa la cámara para que puedas sacar fotos de tu recorrido. Las fotos quedan en este teléfono y no se envían a ningún lado.",
          "photosPermission": "TrekkApp no necesita acceder a tus fotos. Sólo guarda las que sacás durante un recorrido."
        }
      ]
    ],
    "scheme": "trekkapp",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4b0a8af5-ac46-4553-99bf-ce11d4f61bbb"
      }
    }
  }
}
